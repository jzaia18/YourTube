{
  "manifest_version": 3,
  "name": "YourTube – Your rewritten UI for YouTube",
  "short_name": "YourTube",
  "version": "0.1.0.11",
  "version_name": "0.1.0-dev11",
  "description": "Hide Shorts, ads around videos, and other clutter, and choose where the YouTube logo leads. Every change can be switched off.",
  "homepage_url": "https://github.com/jzaia18/YourTube",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background/background.js",
    "scripts": ["src/background/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "YourTube",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": [
        "src/shared/settings.js",
        "src/shared/logo-link.js",
        "src/content/logo-link.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/logo-link.css",
        "src/content/hide-page-ads.css",
        "src/content/hide-ask-button.css",
        "src/content/hide-join-button.css",
        "src/content/hide-store-shelf.css",
        "src/content/hide-shorts.css",
        "src/content/hide-guide-explore.css",
        "src/content/hide-guide-more-from-youtube.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "152",
  "browser_specific_settings": {
    "gecko": {
      "id": "@yourtube-rewriter",
      "strict_min_version": "147.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
