{
  "manifest_version": 3,
  "name": "OurTube",
  "version": "0.1.0",
  "description": "Rewrites the YouTube UI.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background/background.js",
    "scripts": ["src/background/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "OurTube",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["src/content/css-toggle.js", "src/content/logo-link.js", "src/content/hide-ask-button.js", "src/content/hide-shorts-in-subscriptions.js", "src/content/content.js"],
      "css": ["src/content/logo-link.css", "src/content/hide-ask-button.css", "src/content/hide-shorts-in-subscriptions.css"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "152",
  "browser_specific_settings": {
    "gecko": {
      "id": "@ourtube",
      "strict_min_version": "147.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
